rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.expiresAt > request.time;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['enabled', 'expiresAt'])
        && request.resource.data.enabled == true
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(1, 'h');
      allow update: if signedIn()
        && uid == request.auth.uid
        && (!('expiresAt' in resource.data) || resource.data.expiresAt <= request.time)
        && request.resource.data.keys().hasOnly(['enabled', 'expiresAt'])
        && request.resource.data.enabled == true
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(1, 'h');
      allow list, delete: if false;
    }

    // Invite URLs are single-use bearer tokens. Public access is limited to
    // reading one known, unexpired invite so an invite can authorize signup.
    match /adminInvites/{inviteId} {
      allow get: if resource.data.used == false && resource.data.expiresAt > request.time;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'expiresAt', 'used'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.used == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(2, 'h');
      allow update: if signedIn()
        && resource.data.email == request.auth.token.email
        && resource.data.used == false
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && request.resource.data.used == true;
      allow delete: if isAdmin();
    }

    // Signed-in accounts can maintain only their own basic profile.
    // Signup codes are validated by the server and must not be published in rules.
    match /userProfiles/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /syncLeases/{channelId} {
      allow read, create, update, delete: if isAdmin();
    }

    // These collections contain public YouTube metadata and website presentation fields.
    match /channels/{channelId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.id == channelId
        && request.resource.data.enabled is bool;
      allow delete: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.id == videoId
        && request.resource.data.title is string
        && request.resource.data.channelId is string;
      allow delete: if isAdmin();
    }

    match /playlists/{playlistId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.id == playlistId
        && request.resource.data.title is string
        && request.resource.data.videoIds is list;
      allow delete: if isAdmin();
    }

    match /meetings/{meetingId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.startsAt is string
        && request.resource.data.endsAt is string
        && request.resource.data.meetingUrl is string;
      allow delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
  }
}
