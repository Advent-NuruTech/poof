rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Email and password sign-in is all that is required: once the session
    // endpoint verifies the account it writes an enabled, unexpired admin
    // document and the account can open the admin pages. No signup code,
    // invite, or bootstrap flow is involved.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.expiresAt > request.time;
    }

    match /admins/{uid} {
      // Written by the session endpoint after a verified email/password
      // sign-in. Signed-in accounts may maintain only their own record and
      // cannot grant access to anyone else. `codeHash` is a leftover field
      // from the old signup-code flow: it is tolerated on existing documents
      // but is no longer required and grants nothing by itself.
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['enabled', 'expiresAt', 'codeHash'])
        && request.resource.data.enabled == true
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h')
        && (!('codeHash' in request.resource.data)
          || (request.resource.data.codeHash is string && request.resource.data.codeHash.size() > 0));
      allow list, delete: if false;
    }

    // Signed-in accounts can maintain only their own basic profile.
    // The signup code (used only when creating an account) is validated by
    // /api/auth/signup and must never be published in rules.
    match /userProfiles/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /syncLeases/{channelId} {
      allow read, create, update, delete: if isAdmin();
    }

    // These collections contain public YouTube metadata and website presentation fields.
    match /channels/{channelId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.id == channelId
        && request.resource.data.enabled is bool;
      allow delete: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.id == videoId
        && request.resource.data.title is string
        && request.resource.data.channelId is string;
      allow delete: if isAdmin();
    }

    match /playlists/{playlistId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.id == playlistId
        && request.resource.data.title is string
        && request.resource.data.videoIds is list;
      allow delete: if isAdmin();
    }

    match /meetings/{meetingId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.startsAt is string
        && request.resource.data.endsAt is string
        && request.resource.data.meetingUrl is string;
      allow delete: if isAdmin();
    }

    match /libraryCategories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'parentId'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && (request.resource.data.parentId == null || request.resource.data.parentId is string);
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'parentId'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && (request.resource.data.parentId == null || request.resource.data.parentId is string);
      allow delete: if isAdmin();
    }

    match /libraryDocuments/{documentId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'description', 'categoryId', 'categoryName', 'kind', 'contentHtml', 'fileUrl', 'previewUrl', 'fileName', 'createdAt', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.categoryId is string
        && request.resource.data.categoryName is string
        && request.resource.data.kind in ['note', 'pdf', 'doc']
        && (request.resource.data.previewUrl == null || request.resource.data.previewUrl is string)
        && ((request.resource.data.kind == 'note' && request.resource.data.contentHtml is string && request.resource.data.contentHtml.size() <= 1000000)
          || (request.resource.data.kind in ['pdf', 'doc'] && request.resource.data.fileUrl is string && request.resource.data.fileName is string));
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'description', 'categoryId', 'categoryName', 'kind', 'contentHtml', 'fileUrl', 'previewUrl', 'fileName', 'createdAt', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.kind in ['note', 'pdf', 'doc']
        && (request.resource.data.previewUrl == null || request.resource.data.previewUrl is string);
      allow delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow create: if request.resource.data.keys().hasOnly(['category', 'name', 'email', 'phone', 'message', 'createdAt'])
        && request.resource.data.category in ['contact', 'prayer', 'meeting-link']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
  }
}
