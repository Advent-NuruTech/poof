YOUTUBE_DATA_API_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=poof-40b24
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Cloudflare D1 stores synchronized YouTube video metadata (server-only).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
# Cloudflare R2 stores public library originals (server-only S3 credentials).
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
# Optional one-time management token used by `npm run r2:cors` when the S3
# credentials are object-only. Grant R2 bucket edit permission; keep server-only.
CLOUDFLARE_R2_ADMIN_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Paystack secret stays server-only. This integration uses hosted Paystack
# checkout, so a browser-visible public key is not required.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN
# Optional limits expressed in the main currency unit.
PAYSTACK_MIN_AMOUNT=100
PAYSTACK_MAX_AMOUNT=10000000
# Firebase Admin service account credentials for trusted mailing API and scheduler access.
FIREBASE_PROJECT_ID=poof-40b24
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional legacy alternative to the three variables above.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Set a strong random value; Vercel uses this to authenticate the cron request.
CRON_SECRET=
NEWSLETTER_UNSUBSCRIBE_SECRET=
# Override the canonical HTTPS site URL used for metadata, social previews, and newsletter links.
NEXT_PUBLIC_SITE_URL=https://faithofthepioneers.org
