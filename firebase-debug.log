[debug] [2026-10-22T18:37:58.604Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/poof-40b24/rulesets {"name":"projects/poof-40b24/rulesets/5497cad8-320d-4aaf-bab7-d94b2b7c2866","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function signedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isRootAdmin(uid) {\r\n      return uid == '3H3BclyO2FePQ59KYIO2kKSirnx2';\r\n    }\r\n\r\n    function hasAdminSource(uid, admin) {\r\n      return isRootAdmin(uid)\r\n        || (admin.inviteId is string && admin.inviteId.size() >= 16)\r\n        || (admin.codeHash is string && admin.codeHash.size() > 0);\r\n    }\r\n\r\n    function isAdmin() {\r\n      return signedIn()\r\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))\r\n        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true\r\n        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.expiresAt > request.time\r\n        && hasAdminSource(\r\n          request.auth.uid,\r\n          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data\r\n        );\r\n    }\r\n\r\n    function validAdminInvite(inviteId) {\r\n      return exists(/databases/$(database)/documents/adminInvites/$(inviteId))\r\n        && get(/databases/$(database)/documents/adminInvites/$(inviteId)).data.email == request.auth.token.email\r\n        && get(/databases/$(database)/documents/adminInvites/$(inviteId)).data.used == false\r\n        && get(/databases/$(database)/documents/adminInvites/$(inviteId)).data.expiresAt > request.time;\r\n    }\r\n\r\n    match /admins/{uid} {\r\n      allow get: if signedIn() && request.auth.uid == uid;\r\n      allow create: if signedIn()\r\n        && uid == request.auth.uid\r\n        && request.resource.data.enabled == true\r\n        && request.resource.data.expiresAt > request.time\r\n        && request.resource.data.expiresAt <= request.time + duration.value(123, 'd')\r\n        && ((isRootAdmin(uid)\r\n            && request.resource.data.keys().hasOnly(['enabled', 'expiresAt', 'sessionMigrated'])\r\n            && request.resource.data.sessionMigrated == true)\r\n          || (request.resource.data.keys().hasOnly(['enabled', 'expiresAt', 'inviteId', 'sessionMigrated'])\r\n            && request.resource.data.inviteId is string\r\n            && request.resource.data.sessionMigrated == true\r\n            && validAdminInvite(request.resource.data.inviteId)));\r\n      allow update: if signedIn()\r\n        && uid == request.auth.uid\r\n        && resource.data.enabled == true\r\n        && request.resource.data.enabled == true\r\n        && request.resource.data.expiresAt > request.time\r\n        && request.resource.data.expiresAt <= request.time + duration.value(123, 'd')\r\n        && ((hasAdminSource(uid, resource.data)\r\n            && request.resource.data.sessionMigrated == true\r\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt', 'sessionMigrated']))\r\n          || (!hasAdminSource(uid, resource.data)\r\n            && request.resource.data.sessionMigrated == true\r\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt', 'inviteId', 'sessionMigrated'])\r\n            && request.resource.data.inviteId is string\r\n            && validAdminInvite(request.resource.data.inviteId)));\r\n      allow list, delete: if false;\r\n    }\r\n\r\n    match /adminInvites/{inviteId} {\r\n      allow get: if true;\r\n      allow create: if isAdmin()\r\n        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'expiresAt', 'used'])\r\n        && request.resource.data.email is string\r\n        && request.resource.data.email.size() > 0\r\n        && request.resource.data.email.size() <= 254\r\n        && request.resource.data.createdAt == request.time\r\n        && request.resource.data.expiresAt > request.time\r\n        && request.resource.data.expiresAt <= request.time + duration.value(2, 'h')\r\n        && request.resource.data.used == false;\r\n      allow update: if signedIn()\r\n        && resource.data.email == request.auth.token.email\r\n        && resource.data.used == false\r\n        && resource.data.expiresAt > request.time\r\n        && request.resource.data.used == true\r\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']);\r\n      allow list, delete: if false;\r\n    }\r\n\r\n    match /userProfiles/{uid} {\r\n      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;\r\n    }\r\n\r\n    match /syncLeases/{channelId} {\r\n      allow read, create, update, delete: if isAdmin();\r\n    }\r\n\r\n    // These collections contain public YouTube metadata and website presentation fields.\r\n    match /channels/{channelId} {\r\n      allow read: if true;\r\n      allow create, update: if isAdmin()\r\n        && request.resource.data.id == channelId\r\n        && request.resource.data.enabled is bool;\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    match /videos/{videoId} {\r\n      allow read: if true;\r\n      allow create, update: if isAdmin()\r\n        && request.resource.data.id == videoId\r\n        && request.resource.data.title is string\r\n        && request.resource.data.channelId is string;\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    match /playlists/{playlistId} {\r\n      allow read: if true;\r\n      allow create, update: if isAdmin()\r\n        && request.resource.data.id == playlistId\r\n        && request.resource.data.title is string\r\n        && request.resource.data.videoIds is list;\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    match /testimonies/{testimonyId} {\r\n      allow read: if true;\r\n      allow create, update, delete: if isAdmin();\r\n    }\r\n\r\n    match /meetings/{meetingId} {\r\n      allow read: if true;\r\n      allow create, update: if isAdmin()\r\n        && request.resource.data.title is string\r\n        && request.resource.data.startsAt is string\r\n        && request.resource.data.endsAt is string\r\n        && request.resource.data.meetingUrl is string;\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    match /libraryCategories/{categoryId} {\r\n      allow read: if true;\r\n      allow create: if isAdmin()\r\n        && request.resource.data.keys().hasOnly(['name', 'parentId'])\r\n        && request.resource.data.name is string\r\n        && request.resource.data.name.size() > 0\r\n        && request.resource.data.name.size() <= 100\r\n        && (request.resource.data.parentId == null || request.resource.data.parentId is string);\r\n      allow update: if isAdmin()\r\n        && request.resource.data.keys().hasOnly(['name', 'parentId'])\r\n        && request.resource.data.name is string\r\n        && request.resource.data.name.size() > 0\r\n        && request.resource.data.name.size() <= 100\r\n        && (request.resource.data.parentId == null || request.resource.data.parentId is string);\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    match /libraryDocuments/{documentId} {\r\n      allow read: if true;\r\n      allow create: if isAdmin()\r\n        && request.resource.data.keys().hasOnly(['title', 'description', 'categoryId', 'categoryName', 'kind', 'contentHtml', 'fileUrl', 'previewUrl', 'fileName', 'createdAt', 'updatedAt'])\r\n        && request.resource.data.title is string\r\n        && request.resource.data.title.size() > 0\r\n        && request.resource.data.categoryId is string\r\n        && request.resource.data.categoryName is string\r\n        && request.resource.data.kind in ['note', 'pdf', 'doc']\r\n        // Optional keys must be guarded before access. Reading an absent map\r\n        // key is a rules evaluation error, which previously denied every new\r\n        // note and file because neither payload includes previewUrl.\r\n        && (!('previewUrl' in request.resource.data)\r\n          || request.resource.data.previewUrl == null\r\n          || request.resource.data.previewUrl is string)\r\n        && ((request.resource.data.kind == 'note' && request.resource.data.contentHtml is string && request.resource.data.contentHtml.size() <= 1000000)\r\n          || (request.resource.data.kind in ['pdf', 'doc'] && request.resource.data.fileUrl is string && request.resource.data.fileName is string));\r\n      allow update: if isAdmin()\r\n        && request.resource.data.keys().hasOnly(['title', 'description', 'categoryId', 'categoryName', 'kind', 'contentHtml', 'fileUrl', 'previewUrl', 'fileName', 'createdAt', 'updatedAt'])\r\n        && request.resource.data.title is string\r\n        && request.resource.data.title.size() > 0\r\n        && request.resource.data.kind in ['note', 'pdf', 'doc']\r\n        && (!('previewUrl' in request.resource.data)\r\n          || request.resource.data.previewUrl == null\r\n          || request.resource.data.previewUrl is string);\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    match /contacts/{contactId} {\r\n      allow create: if request.resource.data.keys().hasOnly(['category', 'name', 'email', 'phone', 'message', 'createdAt'])\r\n        && request.resource.data.category in ['contact', 'prayer', 'meeting-link']\r\n        && request.resource.data.name is string\r\n        && request.resource.data.name.size() > 0\r\n        && request.resource.data.name.size() <= 120\r\n        && request.resource.data.email is string\r\n        && request.resource.data.email.size() > 0\r\n        && request.resource.data.email.size() <= 254\r\n        && request.resource.data.phone is string\r\n        && request.resource.data.phone.size() <= 40\r\n        && request.resource.data.message is string\r\n        && request.resource.data.message.size() > 0\r\n        && request.resource.data.message.size() <= 4000\r\n        && request.resource.data.createdAt == request.time;\r\n      allow read, delete: if isAdmin();\r\n      allow update: if isAdmin()\r\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handledAt'])\r\n        && request.resource.data.status in ['pending', 'handled']\r\n        && (request.resource.data.status == 'pending' ? request.resource.data.handledAt == null : request.resource.data.handledAt == request.time);\r\n    }\r\n\r\n    // Donation PII, payment status, receipt state, and abuse-control records are\r\n    // only accessed through authenticated server routes using Firebase Admin.\r\n    match /donations/{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n    match /donationStats/{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n    match /donationRateLimits/{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-10-22T18:37:58.946863Z","metadata":{"services":["cloud.firestore"]}}
